NODE_ENV=development
PORT=3000
DATABASE_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
APP_URL=
# Simulation only; always rejected in staging/production. No external funds move.
SAVINGS_SIMULATION_ENABLED=false

# T36: PostgreSQL-only queues. Install the pinned t36_jobs schema explicitly.
# Both defaults prevent any new background work or external reminder delivery.
T36_JOBS_ENABLED=false
T36_EMAIL_MODE=disabled
# simulate records test delivery without sending; production/staging reject resend.
# Membership renewal and SMS remain disabled; no expiry policy/provider is inferred.
T36_RESEND_WEBHOOK_SECRET=
