+}
+.marketing-site .m-knowledge-page .m-resource-status {
+  grid-column: 2;
+  font-size: 1rem;
+  font-weight: 600;
+  line-height: 1.5;
+}
+.marketing-site .m-knowledge-page .m-knowledge-learning .m-section-heading,
+.marketing-site .m-knowledge-page .m-knowledge-learning .m-reading-grid {
+  grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.7fr);
+  gap: 64px;
+}
+.marketing-site .m-knowledge-page .m-knowledge-learning .m-section-heading {
+  margin-bottom: 28px;
+}
+.marketing-site .m-knowledge-page .m-knowledge-learning .m-statement {
+  font-size: clamp(1.5rem, 2.2vw, 2rem);
+  max-width: 20ch;
+}
+.marketing-site .m-knowledge-page .m-knowledge-learning .m-reading-grid > div {
+  max-width: 60ch;
+}
+.marketing-site
+  .m-knowledge-page
+  .m-knowledge-learning
+  .m-reading-grid
+  > div
+  > p {
+  line-height: 1.6;
+}
+@media (min-width: 901px) {
+  .marketing-site .m-knowledge-page .m-intro-grid {
+    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
+    gap: 48px;
+  }
+  .marketing-site .m-knowledge-page .m-intro h1 {
+    max-width: 20ch;
+  }
+}
+@media (max-width: 800px) {
