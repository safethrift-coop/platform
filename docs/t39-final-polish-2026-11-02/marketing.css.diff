+    display: grid;
+    grid-template-columns: minmax(0, 1fr);
+    gap: 0;
+    padding: 20px;
+  }
+  .marketing-site .m-about-page .m-governance-list article + article {
+    margin-top: 20px;
+    padding-top: 20px;
+    border-top: 1px solid var(--b-rule);
+  }
+}
+@media (max-width: 700px) {
+  .marketing-site .m-about-page .m-section,
+  .marketing-site .m-about-page .m-invitation {
+    padding-block: 32px;
+  }
+  .marketing-site .m-about-page .m-section-heading,
+  .marketing-site .m-knowledge-page .m-knowledge-learning .m-section-heading {
+    margin-bottom: 20px;
+  }
+  .marketing-site .m-about-page .m-section-heading .m-label,
+  .marketing-site .m-knowledge-page .m-section-heading .m-label {
+    margin-bottom: 12px;
+  }
+  .marketing-site .m-about-page .m-principles,
+  .marketing-site .m-about-page .m-facts {
+    grid-template-columns: minmax(0, 1fr);
+  }
+  .marketing-site .m-about-page .m-principles li {
+    padding-block: 20px;
+    column-gap: 12px;
+  }
+  .marketing-site .m-knowledge-page .m-library-grid,
+  .marketing-site .m-knowledge-page .m-knowledge-learning .m-reading-grid {
+    gap: 20px;
+  }
+  .marketing-site .m-knowledge-page .m-resource-index article {
+    padding-block: 20px;
+    column-gap: 12px;
+  }
+}
