--- starting Phase B/apps/web/src/components/public-site/marketing.css
+++ final polish/apps/web/src/components/public-site/marketing.css
@@ -2341,3 +2341,234 @@
 .marketing-site :is(.b-account, .b-story-copy, .b-today, .b-governance) h3 {
   font-weight: 700;
 }
+
+/* T39 final polish: every new selector requires one of these two page markers.
+   Existing shared rules, typefaces, palette, navigation and footer are unchanged. */
+.marketing-site .m-about-page .m-section {
+  padding-block: 48px;
+}
+.marketing-site .m-about-page .m-section-heading {
+  margin-bottom: 24px;
+}
+.marketing-site .m-about-page .m-intro-copy > p,
+.marketing-site .m-knowledge-page .m-intro-copy > p {
+  line-height: 1.6;
+}
+.marketing-site .m-about-page .m-intro-note,
+.marketing-site .m-knowledge-page .m-intro-note {
+  font-size: 1rem;
+  margin-top: 16px;
+}
+.marketing-site .m-about-page .m-about-purpose .m-reading-grid {
+  grid-template-columns: 3fr 9fr;
+  gap: 32px;
+}
+.marketing-site .m-about-page .m-about-purpose .m-statement {
+  font-size: clamp(1.5rem, 2.2vw, 2rem);
+  max-width: 20ch;
+}
+.marketing-site .m-about-page .m-about-purpose .m-reading-grid > div {
+  max-width: 62ch;
+}
+.marketing-site .m-about-page .m-about-purpose h3 {
+  margin-bottom: 12px;
+}
+.marketing-site .m-about-page .m-about-purpose h3:not(:first-child) {
+  margin-top: 24px;
+}
+.marketing-site .m-about-page .m-about-purpose .m-reading-grid > div > p {
+  line-height: 1.6;
+}
+.marketing-site .m-about-page .m-principles {
+  gap: 0 48px;
+}
+.marketing-site .m-about-page .m-principles li {
+  grid-template-columns: 2rem minmax(0, 1fr);
+  column-gap: 16px;
+  padding-block: 24px;
+  align-items: start;
+}
+.marketing-site .m-about-page .m-principles li > span,
+.marketing-site .m-knowledge-page .m-resource-number {
+  font: 600 1rem/1.5 var(--b-display);
+  font-variant-numeric: tabular-nums;
+  padding-top: 3px;
+}
+.marketing-site .m-about-page .m-principles h3 {
+  margin-bottom: 8px;
+}
+.marketing-site .m-about-page .m-principles li > div {
+  max-width: 48ch;
+}
+.marketing-site .m-about-page .m-principles p {
+  margin: 0;
+  line-height: 1.5;
+}
+.marketing-site .m-about-page .m-governance-list {
+  margin-top: 28px;
+  padding: 24px;
